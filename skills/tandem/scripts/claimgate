#!/usr/bin/env python3
"""claimgate — mechanical gate for a tandem campaign's claims table.

Usage:
  claimgate <campaign-dir> [--no-net] [--json] [--ledger PATH]
            [--no-narrative] [--tolerance 0.05] [--capacity PATH]

Exit codes: 0 = every row passes, 1 = at least one FAIL, 2 = usage/parse error.

Checks per row (by label):
  predicted       FAIL unless resolved to measured/refuted/not-established.
  measured/refuted/not-established: every evidence path (space- or
    semicolon-separated, `-` = none) must exist and be non-empty.
  cited           every URL must answer HEAD (or GET) with HTTP < 400
                  (skipped with --no-net).
  git             `git:repo:ref:path` must resolve via `git show`.

Narrative checks (v2; run on measured/refuted rows; disabled with
--no-narrative for pre-v2 campaigns). These catch the error class where a
claim's *prose* contradicts what its cited evidence can prove:

  A. I/O method whitelist — a claim that asserts "no/zero file I/O" (or
     equivalent) requires a storage-bytes counter in the cited evidence
     (/proc/pid/io `read_bytes`/`rchar`, block-device sectors, iostat…).
     Syscall tracing (strace pread counts) cannot see page-fault I/O and
     fails this check on its own.
  B. Residency arithmetic — a claim asserting that an object "is / fits /
     lives entirely in RAM/VRAM/memory" requires a capacity manifest
     (capacity-*.tsv under the campaign root, or --capacity) whose
     measured container sum (cgroup_peak + vram_peak + arc_max, in bytes)
     is >= the object size (model_files_bytes) within --tolerance
     (default 5%). Missing manifest or shortfall = FAIL.
  C. Numeric provenance (WARNING ONLY, never fails) — every number in the
     claim row must appear within --tolerance in one of the cited evidence
     files (literal or, for small files, the mean of a pair). Unmatched
     numbers are reported; a number that is not in the data is a
     re-derivation, not a copy.

Stdlib only. The claims file is the deliverable for the verifier.
"""
import argparse
import bisect
import json
import os
import re
import subprocess
import sys
import urllib.request
import urllib.error

NEEDS_FILE = {"measured", "refuted", "not-established"}
FINAL = NEEDS_FILE | {"cited", "git", "predicted"}

# ---- v2: narrative-check patterns ----------------------------------------

IO_NEG_PATTERNS = [
    r"\bzero\s+(file|disk|storage)\s+i/o\b",
    r"\bno\s+(file|disk|storage)\s+i/o\b",
    r"\bzero\s+(file|disk)\s+reads\b",
    r"\bno\s+(file|disk|storage)\s+reads\b",
    r"\bzero\s+storage\b",
    r"\bno\s+file\s+access\b",
    r"\bno\s+disk\s+activity\b",
]
STORAGE_MARKERS = ["read_bytes", "rchar", "sectors_read", "read sectors",
                   "iostat", "diskstats", "blkio"]

RESIDENCY_PATTERNS = [
    r"\bentirely\s+in\s+(ram|memory|host\s+ram|vram)\b",
    r"\bfully\s+(in|resident\s+in|on)\s+(ram|memory|vram)\b",
    r"\beverything\s+in\s+ram\b",
    r"\ball\s+in\s+ram\b",
    r"\ball\s+of\s+(it|the\s+model|the\s+weights|the\s+table)s?\s+(is|are|sits|lives)\b",
    r"\bwhole\s+model\s+(is|fits|lives|sits)\b",
    r"\bmodel\s+fully\s+resident\b",
    r"\bfits\s+(in|on)\s+(ram|memory|vram|host\s+ram)\b",
]

CONTAINER_KEYS = ("cgroup_peak_bytes", "vram_peak_bytes", "arc_max_bytes")
OBJECT_KEYS = ("model_files_bytes", "object_bytes")

NUM_RE = re.compile(r"\b\d+(?:\.\d+)?\b")


def fail(msg):
    print(f"claimgate: {msg}", file=sys.stderr)
    sys.exit(2)


def ev_paths(ev):
    """Extract path-like tokens from an evidence cell. The cell may carry
    prose ("file.txt (superseded — see X)"); only tokens that look like
    paths (contain a slash, or a bare name with an extension) are paths."""
    ext = re.compile(r"^\S+\.\w{1,5}$")
    out = []
    for tok in re.split(r"[;\s]+", ev):
        t = tok.strip().strip("()[]<>\"'.,;:")
        if not t or t == "-":
            continue
        if "/" in t or ext.match(t):
            out.append(t)
    return out


def read_ev(root, ev):
    """Return the concatenated text of cited evidence files (empty if none)."""
    out = []
    for p in ev_paths(ev):
        fp = os.path.join(root, p)
        try:
            with open(fp, encoding="utf-8", errors="replace") as f:
                out.append(f.read())
        except OSError:
            pass
    return "\n".join(out)


def find_capacity(root):
    hits = []
    for dirpath, _dirnames, filenames in os.walk(root):
        for fn in filenames:
            if "capacity" in fn and fn.endswith(".tsv"):
                hits.append(os.path.join(dirpath, fn))
    hits.sort()
    return hits[0] if hits else None


def parse_capacity(path):
    d = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) >= 2:
                try:
                    d[parts[0].strip()] = int(float(parts[1]))
                except ValueError:
                    pass
    return d


def check_io_method(claim, ev_text):
    """Check A: negative-I/O claims need a storage-bytes counter."""
    cl = claim.lower()
    if not any(re.search(p, cl) for p in IO_NEG_PATTERNS):
        return True, ""
    if any(m in ev_text.lower() for m in STORAGE_MARKERS):
        return True, ""
    return (False,
            "negative-I/O claim but no storage-bytes counter in cited "
            "evidence (strace/syscall traces cannot see page faults; cite "
            "/proc/pid/io read_bytes or block-device stats)")


def check_residency(claim, root, cap_path, tol):
    """Check B: full-residency claims need container sum >= object size."""
    cl = claim.lower()
    if not any(re.search(p, cl) for p in RESIDENCY_PATTERNS):
        return True, "", None
    if cap_path is None:
        cap_path = find_capacity(root)
    if not cap_path or not os.path.isfile(cap_path):
        return (False,
                "residency claim but no capacity manifest "
                "(capacity-*.tsv under the campaign root, or --capacity)",
                None)
    cap = parse_capacity(cap_path)
    obj = None
    for k in OBJECT_KEYS:
        if k in cap:
            obj = cap[k]
            break
    if obj is None:
        return (False,
                f"capacity manifest {cap_path} has no object size "
                "(model_files_bytes / object_bytes)",
                cap_path)
    containers = sum(cap.get(k, 0) for k in CONTAINER_KEYS)
    if containers == 0:
        return (False,
                f"capacity manifest {cap_path} has no container keys "
                f"({', '.join(CONTAINER_KEYS)})",
                cap_path)
    if obj > containers * (1 + tol):
        return (False,
                f"residency claim fails arithmetic: object {obj/2**30:.2f} "
                f"GiB > containers {containers/2**30:.2f} GiB "
                f"(+{tol:.0%}) — {cap_path}",
                cap_path)
    return (True,
            f"residency ok: object {obj/2**30:.2f} GiB <= "
            f"containers {containers/2**30:.2f} GiB",
            cap_path)


def ev_numbers(text):
    nums = []
    for tok in NUM_RE.findall(text):
        try:
            v = float(tok)
        except ValueError:
            continue
        if 1900 <= v <= 2100 and v == int(v):
            continue  # years
        nums.append(v)
    return nums


def check_provenance(claim, ev_text, tol):
    """Check C (warning-only): claim numbers vs evidence numbers."""
    ev_nums = ev_numbers(ev_text)
    if not ev_nums:
        return []
    ev_sorted = sorted(ev_nums)
    warnings = []
    for tok in NUM_RE.findall(claim):
        try:
            n = float(tok)
        except ValueError:
            continue
        if 1900 <= n <= 2100 and n == int(n):
            continue
        lo, hi = n * (1 - tol), n * (1 + tol)
        i = bisect.bisect_left(ev_sorted, lo)
        if i < len(ev_sorted) and ev_sorted[i] <= hi:
            continue
        # mean of a pair (small evidence sets only)
        if len(ev_sorted) <= 300:
            found = False
            for a in range(len(ev_sorted)):
                if found:
                    break
                lo2 = 2 * n - ev_sorted[a]
                j = bisect.bisect_left(ev_sorted, lo2)
                if j < len(ev_sorted) and abs(ev_sorted[j] - lo2) <= max(abs(lo2), 1) * tol:
                    found = True
            if found:
                continue
        warnings.append(tok)
    return warnings


def check_file(root, ev):
    for p in ev_paths(ev):
        fp = os.path.join(root, p)
        if not os.path.isfile(fp):
            return False, f"{p} missing"
        if os.path.getsize(fp) == 0:
            return False, f"{p} empty"
    return True, ""


def check_url(ev, no_net):
    for u in ev.split():
        if u in ("-", ""):
            continue
        if no_net:
            continue  # reported as skipped by caller
        ua = {"User-Agent": "claimgate/1.0"}  # some CDNs 403 the default python UA
        try:
            req = urllib.request.Request(u, method="HEAD", headers=ua)
            with urllib.request.urlopen(req, timeout=20) as r:
                code = r.getcode()
            if code >= 400:
                return False, f"{u} -> HTTP {code}"
        except urllib.error.HTTPError as e:
            if e.code in (405, 501):  # HEAD refused: try GET
                try:
                    req = urllib.request.Request(u, method="GET", headers=ua)
                    with urllib.request.urlopen(req, timeout=20) as r:
                        if r.getcode() >= 400:
                            return False, f"{u} -> HTTP {r.getcode()}"
                    continue
                except Exception:
                    return False, f"{u} -> unreadable"
            return False, f"{u} -> HTTP {e.code}"
        except Exception as e:
            return False, f"{u} -> {type(e).__name__}: {e}"
    return True, ""


def check_git(ev):
    parts = ev.split(":", 3)  # git:repo:ref:path
    if len(parts) < 4:
        return False, f"bad git ref {ev!r} (want git:repo:ref:path)"
    _, repo, ref, path = parts
    try:
        r = subprocess.run(["git", "-C", repo, "show", f"{ref}:{path}"],
                           capture_output=True, timeout=30)
    except FileNotFoundError:
        return False, "git not available"
    if r.returncode != 0:
        return False, f"git show {ref}:{path} in {repo} failed"
    return True, ""


def parse_table(path):
    """Parse the claims table. Returns (num, claim, label, ev) rows; label is
    normalized to its first word so 'predicted (basis: …)' is recognized as
    predicted (a v2 fix: the v1 gate let annotated predicted rows pass)."""
    rows = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            s = line.strip()
            if not (s.startswith("|") and s.endswith("|")):
                continue
            cells = [c.strip() for c in s.strip("|").split("|")]
            if len(cells) < 4:
                continue
            num, claim, label, ev = cells[0], cells[1], cells[2], cells[3]
            if not re.fullmatch(r"[CS]\d+(?:\s*\([^)]*\))?", num):
                continue
            raw = label.lower()
            first = raw.split()[0] if raw.strip() else "unknown"
            if first not in FINAL:
                first = "unknown"
            rows.append((num, claim, first, raw, ev))
    return rows


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("campaign")
    ap.add_argument("--no-net", action="store_true", help="skip URL checks")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--ledger", default=None)
    ap.add_argument("--no-narrative", action="store_true",
                    help="skip the v2 narrative checks (pre-v2 campaigns)")
    ap.add_argument("--tolerance", type=float, default=0.05,
                    help="relative tolerance for residency/provenance (default 0.05)")
    ap.add_argument("--capacity", default=None,
                    help="capacity manifest TSV (default: auto-detect capacity-*.tsv)")
    args = ap.parse_args()

    root = os.path.abspath(args.campaign)
    claims = os.path.join(root, "claims.md")
    if not os.path.isfile(claims):
        fail(f"{claims} not found")

    cap_path = None
    if not args.no_narrative:
        cap_path = args.capacity if args.capacity else find_capacity(root)

    results = []
    ok = True
    for num, claim, label, rawlabel, ev in parse_table(claims):
        good, why, skipped = True, "", False
        if label == "predicted":
            good, why = False, "unresolved predicted row (must be measured/refuted/not-established)"
        elif label == "unknown":
            good, why = False, f"unknown label {rawlabel!r}"
        elif label in NEEDS_FILE:
            good, why = check_file(root, ev)
            if good and ev in ("-", ""):
                good, why = False, "no evidence file"
        elif label == "git":
            good, why = check_git(ev)
        elif label == "cited":
            good, why = check_url(ev, args.no_net)
            if good and args.no_net:
                skipped = True

        narrative = []
        if good and not args.no_narrative and label in ("measured", "refuted"):
            # the prose is checked where this campaign puts it: the claim
            # cell plus the label cell (notes are written into the label)
            text = f"{claim} {rawlabel}"
            ev_text = read_ev(root, ev)
            a_good, a_why = check_io_method(text, ev_text)
            b_good, b_why, _ = check_residency(text, root, cap_path, args.tolerance)
            if not a_good:
                good, why = False, f"[check A] {a_why}"
            elif not b_good:
                good, why = False, f"[check B] {b_why}"
            narrative = check_provenance(claim, ev_text, args.tolerance)

        results.append({"row": num, "claim": claim, "label": rawlabel,
                        "evidence": ev, "pass": good and not skipped,
                        "skipped": skipped, "reason": why,
                        "provenance_warnings": narrative})
        ok = ok and (good or skipped)

    if args.ledger and not args.json:
        # advisory: surface ledger entries whose re-derive condition is due
        try:
            text = open(args.ledger, encoding="utf-8").read()
            if "RE-DERIVE" in text.upper():
                print("claimgate: constraint ledger carries a RE-DERIVE marker; "
                      "re-derive the boundary with the human before acting.",
                      file=sys.stderr)
        except OSError:
            pass

    if args.json:
        print(json.dumps({"campaign": root, "ok": ok, "results": results}, indent=1))
    else:
        for r in results:
            mark = "PASS" if r["pass"] else ("SKIP" if r["skipped"] else "FAIL")
            print(f"[{mark}] {r['row']} ({r['label']}) {r['claim'][:60]}")
            if r["reason"]:
                print(f"       {r['reason']}")
            for w in r.get("provenance_warnings", []):
                print(f"       NOTE (check C, warning-only): number '{w}' in claim "
                      f"not found ±{args.tolerance:.0%} in cited evidence")
        print(f"\nclaimgate: {'green' if ok else 'red'}: {len(results)} rows")
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
